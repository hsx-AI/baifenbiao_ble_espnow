[Unit]
Description=BLE Dial Indicator Gateway (Percent Meter)
After=network.target bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
User=percent-meter
Group=percent-meter
SupplementaryGroups=dialout bluetooth
WorkingDirectory=/opt/percent-meter
EnvironmentFile=-/etc/percent-meter/env
ExecStart=/opt/percent-meter/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
